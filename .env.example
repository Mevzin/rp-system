PORT=4000

# -----------------------------------------------------------------------------
# MONGO DB — única fonte de verdade
# -----------------------------------------------------------------------------
# Produção: MongoDB Atlas (formato padrão mongodb+srv).
# Desenvolvimento local (Docker): mongodb://127.0.0.1:27017/criminals
#
# Exemplo real Atlas:
#   mongodb+srv://meuUsuario:minhaSenhaForte@cluster0.fwej7.mongodb.net/criminals?retryWrites=true&w=majority&appName=CriminalsRP
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/criminals?retryWrites=true&w=majority
MONGODB_DB_NAME=criminals
# Timeout de conexão em ms. Redes lentas podem aumentar.
MONGODB_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Identidade da organização
# -----------------------------------------------------------------------------
ORGANIZATION_NAME=Criminals RP

# -----------------------------------------------------------------------------
# DISCORD (OAuth2 + Bot + Guild)
# Pegue TUDO em https://discord.com/developers/applications
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# OAuth2 redirect — cadastre EXATAMENTE esta URL no Discord Developer Portal,
# senão o login retorna "redirect_uri_mismatch".
# Dev:  http://localhost:4000/api/auth/discord/callback
# Prod: https://api.seudominio.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# IDs dos 4 cargos hierárquicos no seu Discord (Copiar ID do cargo).
# OWNER — dono da org (todas as permissões)
# MANAGER — gerencia membros / config / meta / garagem / estoque
# SUPERVISOR — staff que aprova farms e libera acesso de novos membros
# MEMBER — jogador comum
DISCORD_ROLE_OWNER_ID=
DISCORD_ROLE_MANAGER_ID=
DISCORD_ROLE_SUPERVISOR_ID=
DISCORD_ROLE_MEMBER_ID=

# Canais do Discord para log geral, notificações e (OBBRIGATÓRIO) comprovações de farm.
# No canal FARM_PROOFS o bot precisa ter permissões: Enviar mensagens + Anexar arquivos.
DISCORD_CHANNEL_LOGS_ID=
DISCORD_CHANNEL_NOTIFICATIONS_ID=
FARM_PROOFS_DISCORD_CHANNEL_ID=

# -----------------------------------------------------------------------------
# JWT (SEGREDOS — NÃO VERSIONE)
# -----------------------------------------------------------------------------
JWT_SECRET=troque-por-uma-string-aleatoria-muito-longa-pelo-menos-64-caracteres
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-DIFERENTE-do-JWT_SECRET-acima
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Uploads locais (fallback quando Discord CDN não pode ser usado)
# -----------------------------------------------------------------------------
# Pasta de arquivos relativa a apps/api. Apenas o .gitkeep é versionado!
UPLOAD_DIR=./uploads
# Dias para manter arquivos antes da limpeza automática. 0 = nunca apaga.
UPLOAD_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# URLs públicas / CORS
# -----------------------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api
# Separe domínios permitidos por VÍRGULA — SEM ESPAÇOS.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Comunicação Bot → API (opcional, por padrão usa sessão/cookie)
API_KEY=optional-api-key-for-bot-to-api-communication

# -----------------------------------------------------------------------------
# Variáveis EXPOSTAS AO BROWSER (devem ter NEXT_PUBLIC_)
# O front precisa saber onde está a API em tempo de execução.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WEB_URL=http://localhost:3000
