# 14) MONOREPO SPECIFIC (app-level dist/.next são ignorados via glob acima) ----------------
# Se algum pacote gerar arquivo extra local:
packages/*/dist
packages/*/node_modules
apps/*/dist
apps/*/.next
apps/*/node_modules
apps/*/.turbo
packages/*/.turbo

# 15) FIXTURES / SEED locais (não versionar dados reais, só fixtures) ----------------------
seed/local/**
!seed/fixtures/**

# 16) TYPESCRIPT TEMP (ts incremental builds) ----------------------------------------------
