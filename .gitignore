# 8) DADOS LOCAIS / UPLOADS / BANCOS (não versionar, a menos que fixtures) -----------------
# Uploads de imagens/provas — NUNCA commitar. Manter APENAS o .gitkeep de marcador de pasta.
# Obs: NÃO usamos regra genérica "uploads/" porque ela pegaria também a pasta
#      apps/api/src/modules/uploads (código-fonte Nest do módulo Uploads).
apps/api/uploads/*
!apps/api/uploads/.gitkeep
static/
storage/
attachments/
temp/
tmp/

# SQLite (se alguém usar fallback local para testes)
*.sqlite
*.sqlite3
*.db
*.db3
database/

